# Google Apps Script Web App URL (Deploy Code.gs as Web App with access 'Anyone')
NEXT_PUBLIC_KAYAL_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
NEXT_PUBLIC_KAYAL_SAMAYAL_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Razorpay Payment Gateway Keys
# For Test Mode: use keys starting with rzp_test_
# For Live Mode: use keys starting with rzp_live_
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Server-Side Order Token and Authentication Secrets
SERVER_AUTH_SECRET=YOUR_KEY_SECRET

# Razorpay Webhook Secret (configured in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
